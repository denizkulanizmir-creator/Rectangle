powershell -NoProfile -ExecutionPolicy Bypass -Command "$d=[Environment]::GetFolderPath('Desktop')+'\Rectangle'; New-Item -Path $d -ItemType Directory -Force | Out-Null; $q=[char]34; $r='public class Rectangle { public string Even(int n){ return '+$q+'RECTANGLE <- cift: '+$q+' + n; } }'; Add-Type -TypeDefinition $r -Language CSharp -OutputAssembly ($d+'\rectangle.dll') -OutputType Library; $s='public class Special { public string Odd(int n){ var x=new Rectangle(); return '+$q+'SPECIAL <- tek: '+$q+' + n + '+$q+' (rectangle bagli) '+$q+'; } }'; Add-Type -TypeDefinition $s -Language CSharp -OutputAssembly ($d+'\special.dll') -OutputType Library -ReferencedAssemblies ($d+'\rectangle.dll'); $b='using System; public class Program { public static void Main(){ var r=new Rectangle(); var s=new Special(); var rnd=new Random(); for(int i=0;i<10;i++){ int n=rnd.Next(1,100); if(n%2==0) Console.WriteLine(r.Even(n)); else Console.WriteLine(s.Odd(n)); } } }'; Add-Type -TypeDefinition $b -Language CSharp -OutputAssembly ($d+'\bin.exe') -OutputType ConsoleApplication -ReferencedAssemblies ($d+'\rectangle.dll'),($d+'\special.dll'); (New-Object Media.SoundPlayer 'C:\Windows\Media\Windows Ding.wav').PlaySync(); Write-Host 'Bitti:' $d"